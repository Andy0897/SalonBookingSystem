@model List<SalonBookingSystem.Models.Employee>

@{
    ViewData["Title"] = "Нашият екип";
}

<div class="py-4">

    <div class="text-center mb-5">
        <h1 class="section-title text-center">Нашите специалисти</h1>
        <p class="text-muted">Запознайте се с нашия професионален екип.</p>
    </div>

    <div class="row g-4">
        @foreach (var employee in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card card-hover h-100">
                    <div class="card-body p-4">

                        <div class="text-center">
                            <div class="avatar">@employee.User.FirstName.Substring(0, 1)</div>
                            <h4 class="fw-bold mb-1">@employee.User.FirstName @employee.User.LastName</h4>
                            <p class="text-muted mb-3">@employee.Specialty</p>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(employee.Description))
                        {
                            <p class="small text-center">@employee.Description</p>
                        }

                        <hr />

                        <p class="small mb-2">
                            <i class="bi bi-clock text-muted me-1"></i>
                            <strong>Работно време:</strong> @employee.WorkStart - @employee.WorkEnd
                        </p>

                        <div>
                            @foreach (var service in employee.EmployeeServices)
                            {
                                <span class="badge rounded-pill bg-light text-dark border me-1 mb-1">
                                    @service.BeautyService.Name
                                </span>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

</div>
