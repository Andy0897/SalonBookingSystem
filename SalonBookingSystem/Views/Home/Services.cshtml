@model List<SalonBookingSystem.Models.BeautyService>

@{
    ViewData["Title"] = "Услуги";
}

<div class="py-4">

    <div class="text-center mb-5">
        <h1 class="section-title text-center">Нашите услуги</h1>
        <p class="text-muted">Изберете процедура и запазете удобен час.</p>
    </div>

    <div class="row g-4">
        @foreach (var service in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card card-hover h-100">

                    <div class="card-body p-4">
                        <h4 class="fw-bold">@service.Name</h4>
                        <p class="text-muted small mb-0">Професионална процедура от нашите специалисти.</p>
                    </div>

                    <div class="card-footer bg-transparent border-0 px-4 pb-4 pt-0">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="price">@service.Price лв.</span>
                            <span class="text-muted small"><i class="bi bi-clock"></i> @service.DurationMinutes мин.</span>
                        </div>

                        @if (User.Identity!.IsAuthenticated)
                        {
                            <a asp-controller="Reservation" asp-action="Create" class="btn btn-salon w-100">
                                <i class="bi bi-calendar-plus"></i> Запази час
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-salon w-100">
                                Влез за резервация
                            </a>
                        }
                    </div>

                </div>
            </div>
        }
    </div>

</div>
