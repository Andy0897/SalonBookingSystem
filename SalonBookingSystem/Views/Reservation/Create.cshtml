@model SalonBookingSystem.Models.ViewModels.ReservationFormViewModel

@{
    ViewData["Title"] = "Нова резервация";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-7">

        <div class="card">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="form-icon mb-3"><i class="bi bi-calendar-plus"></i></div>
                    <h2 class="fw-bold mb-1">Запази своя час</h2>
                    <p class="text-muted mb-0">Избери услуга, специалист, дата и удобен час.</p>
                </div>

                <form asp-action="Create" method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="BeautyServiceId" class="form-label fw-semibold">
                            <span class="badge rounded-circle bg-secondary me-1">1</span> Услуга
                        </label>
                        <select asp-for="BeautyServiceId" asp-items="Model.Services"
                                class="form-select" id="serviceSelect">
                            <option value="">Изберете услуга</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EmployeeId" class="form-label fw-semibold">
                            <span class="badge rounded-circle bg-secondary me-1">2</span> Специалист
                        </label>
                        <select asp-for="EmployeeId" class="form-select" id="employeeSelect">
                            <option value="">Първо изберете услуга</option>
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="ReservationDate" class="form-label fw-semibold">
                                <span class="badge rounded-circle bg-secondary me-1">3</span> Дата
                            </label>
                            <input asp-for="ReservationDate" type="date" class="form-control" id="dateSelect"
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="StartTime" class="form-label fw-semibold">
                                <span class="badge rounded-circle bg-secondary me-1">4</span> Свободен час
                            </label>
                            <select asp-for="StartTime" asp-items="Model.AvailableTimes"
                                    class="form-select" id="timeSelect">
                                <option value="">Изберете час</option>
                            </select>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-salon w-100 py-2">
                        <i class="bi bi-check-lg"></i> Потвърди резервация
                    </button>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const serviceSelect = document.getElementById("serviceSelect");
        const employeeSelect = document.getElementById("employeeSelect");
        const dateSelect = document.getElementById("dateSelect");
        const timeSelect = document.getElementById("timeSelect");

        function fillSelect(select, placeholder, items) {
            select.innerHTML = "<option value=''>" + placeholder + "</option>";

            items.forEach(item => {
                let option = document.createElement("option");
                option.value = item.value;
                option.text = item.text;
                select.appendChild(option);
            });
        }

        serviceSelect.addEventListener("change", function() {
            let serviceId = this.value;

            fillSelect(timeSelect, "Изберете час", []);

            if (serviceId === "") {
                fillSelect(employeeSelect, "Първо изберете услуга", []);
                return;
            }

            fetch('/Reservation/GetEmployees?serviceId=' + serviceId)
                .then(response => response.json())
                .then(data => fillSelect(employeeSelect, "Изберете специалист", data));
        });

        function loadTimes() {
            let employeeId = employeeSelect.value;
            let serviceId = serviceSelect.value;
            let date = dateSelect.value;

            if (employeeId && serviceId && date) {
                fetch(`/Reservation/GetAvailableTimes?employeeId=${employeeId}&beautyServiceId=${serviceId}&date=${date}`)
                    .then(response => response.json())
                    .then(data => fillSelect(timeSelect,
                        data.length ? "Изберете час" : "Няма свободни часове", data));
            }
        }

        employeeSelect.addEventListener("change", loadTimes);
        dateSelect.addEventListener("change", loadTimes);
    </script>
}
