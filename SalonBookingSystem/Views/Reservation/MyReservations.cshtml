@model List<SalonBookingSystem.Models.Reservation>

@{
    ViewData["Title"] = "Моите резервации";
}

<div class="py-3">

    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 class="fw-bold mb-1">Моите резервации</h2>
            <p>Преглед на вашите запазени часове.</p>
        </div>
        <a asp-controller="Reservation" asp-action="Create" class="btn btn-salon">
            <i class="bi bi-calendar-plus"></i> Нова резервация
        </a>
    </div>

    <div class="card overflow-hidden">

        @if (!Model.Any())
        {
            <div class="text-center p-5">
                <i class="bi bi-calendar-heart fs-1 text-muted"></i>
                <h5 class="fw-bold mt-2">Нямате направени резервации</h5>
                <p class="text-muted">Все още не сте запазили час.</p>
                <a asp-controller="Reservation" asp-action="Create" class="btn btn-salon">Запази час</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Услуга</th>
                            <th>Служител</th>
                            <th>Дата</th>
                            <th>Час</th>
                            <th>Статус</th>
                            <th class="text-end pe-4">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservation in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@reservation.BeautyService.Name</td>
                                <td>@reservation.Employee.User.FirstName @reservation.Employee.User.LastName</td>
                                <td>@reservation.ReservationDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-nowrap">@reservation.StartTime - @reservation.EndTime</td>
                                <td><partial name="_StatusBadge" model="reservation.Status" /></td>
                                <td class="text-end pe-4">
                                    @if (reservation.Status == SalonBookingSystem.Models.Enums.ReservationStatus.Reserved)
                                    {
                                        <form asp-action="Cancel" method="post" asp-route-id="@reservation.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Сигурни ли сте, че искате да откажете резервацията?')">
                                                <i class="bi bi-x-lg"></i> Откажи
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</div>
