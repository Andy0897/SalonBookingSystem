@model SalonBookingSystem.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Административен панел";

    var stats = new[]
    {
        ("Потребители", Model.UsersCount, "bi-people"),
        ("Служители", Model.EmployeesCount, "bi-person-badge"),
        ("Услуги", Model.ServicesCount, "bi-stars"),
        ("Предстоящи резервации", Model.ReservationsCount, "bi-calendar-check")
    };
}

<div class="py-3">

    <div class="page-header">
        <h2 class="fw-bold mb-1">Административен панел</h2>
        <p>Общ преглед на системата и последните резервации.</p>
    </div>

    <div class="row g-4">
        @foreach (var stat in stats)
        {
            <div class="col-lg-3 col-md-6">
                <div class="card h-100">
                    <div class="card-body p-4 d-flex align-items-center gap-3">
                        <div class="stat-icon"><i class="bi @stat.Item3"></i></div>
                        <div>
                            <div class="text-muted small">@stat.Item1</div>
                            <div class="fs-2 fw-bold lh-1">@stat.Item2</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="card mt-4 overflow-hidden">

        <div class="card-body p-4 pb-3">
            <h4 class="fw-bold mb-1">Последни резервации</h4>
            <p class="text-muted mb-0">Най-новите записи в системата.</p>
        </div>

        @if (!Model.LastReservations.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x fs-1 text-muted"></i>
                <h5 class="fw-bold mt-2">Няма резервации</h5>
                <p class="text-muted mb-0">Все още няма създадени резервации.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Клиент</th>
                            <th>Служител</th>
                            <th>Услуга</th>
                            <th>Дата</th>
                            <th>Час</th>
                            <th class="pe-4">Статус</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservation in Model.LastReservations)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@reservation.Client.FirstName @reservation.Client.LastName</td>
                                <td>@reservation.Employee.User.FirstName @reservation.Employee.User.LastName</td>
                                <td>@reservation.BeautyService.Name</td>
                                <td>@reservation.ReservationDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-nowrap">@reservation.StartTime - @reservation.EndTime</td>
                                <td class="pe-4"><partial name="_StatusBadge" model="reservation.Status" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</div>
