@model SalonBookingSystem.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Вход";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-5 col-md-7">

        <div class="card">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="form-icon mb-3"><i class="bi bi-person"></i></div>
                    <h2 class="fw-bold mb-1">Добре дошли</h2>
                    <p class="text-muted mb-0">Влезте в своя профил</p>
                </div>

                <form asp-action="Login" method="post">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-salon w-100 py-2">
                        <i class="bi bi-box-arrow-in-right"></i> Вход
                    </button>

                </form>

                <hr class="my-4" />

                <p class="text-center text-muted mb-0">
                    Нямате акаунт?
                    <a asp-action="Register" class="text-decoration-none fw-semibold">Регистрация</a>
                </p>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
