@model List<SalonBookingSystem.Models.Reservation>

@{
    ViewData["Title"] = "Моите резервации";
}

<div class="py-3">

    <div class="page-header">
        <h2 class="fw-bold mb-1">Моите резервации</h2>
        <p>Управление на клиентските посещения.</p>
    </div>

    <div class="card overflow-hidden">

        @if (!Model.Any())
        {
            <div class="text-center p-5">
                <i class="bi bi-calendar fs-1 text-muted"></i>
                <h5 class="fw-bold mt-2">Няма предстоящи резервации</h5>
                <p class="text-muted mb-0">Все още няма планирани посещения.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Клиент</th>
                            <th>Телефон</th>
                            <th>Услуга</th>
                            <th>Дата</th>
                            <th>Час</th>
                            <th>Статус</th>
                            <th class="text-end pe-4">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservation in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@reservation.Client.FirstName @reservation.Client.LastName</td>
                                <td class="text-muted">@reservation.Client.PhoneNumber</td>
                                <td>@reservation.BeautyService.Name</td>
                                <td>@reservation.ReservationDate.ToString("dd.MM.yyyy")</td>
                                <td class="text-nowrap">@reservation.StartTime - @reservation.EndTime</td>
                                <td><partial name="_StatusBadge" model="reservation.Status" /></td>
                                <td class="text-end pe-4 text-nowrap">
                                    <a asp-action="ReservationDetails" asp-route-id="@reservation.Id"
                                       class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-eye"></i> Детайли
                                    </a>

                                    @if (reservation.Status == SalonBookingSystem.Models.Enums.ReservationStatus.Reserved)
                                    {
                                        <form asp-action="CompleteReservation" asp-route-id="@reservation.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-salon btn-sm">
                                                <i class="bi bi-check-lg"></i> Приключи
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</div>
