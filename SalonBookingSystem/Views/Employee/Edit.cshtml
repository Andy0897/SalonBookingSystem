@model SalonBookingSystem.Models.ViewModels.EmployeeFormViewModel

@{
    ViewData["Title"] = "Редактиране на служител";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">

        <div class="card">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="form-icon mb-3"><i class="bi bi-pencil"></i></div>
                    <h2 class="fw-bold mb-1">Редактиране на служител</h2>
                    <p class="text-muted mb-0">Актуализирайте информацията и услугите.</p>
                </div>

                <form asp-action="Edit">

                    <input asp-for="Id" type="hidden" />
                    <input asp-for="UserId" type="hidden" />

                    <h6 class="text-uppercase text-muted small fw-bold mb-3">Основна информация</h6>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Потребител</label>
                            <input class="form-control bg-light"
                                   value="@Model.User.FirstName @Model.User.LastName" disabled />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Specialty" class="form-label fw-semibold"></label>
                            <input asp-for="Specialty" class="form-control" />
                            <span asp-validation-for="Specialty" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row mb-2">
                        <div class="col-md-6 mb-3">
                            <label asp-for="WorkStart" class="form-label fw-semibold"></label>
                            <input asp-for="WorkStart" type="time" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="WorkEnd" class="form-label fw-semibold"></label>
                            <input asp-for="WorkEnd" type="time" class="form-control" />
                        </div>
                    </div>

                    <hr class="my-4" />

                    <h6 class="text-uppercase text-muted small fw-bold mb-3">Предлагани услуги</h6>

                    <div class="row g-3">
                        @for (int i = 0; i < Model.Services.Count; i++)
                        {
                            <div class="col-md-6">
                                <div class="service-check form-check mb-0">
                                    <input asp-for="Services[i].Selected" class="form-check-input ms-0 me-2" />
                                    <input asp-for="Services[i].BeautyServiceId" type="hidden" />
                                    <input asp-for="Services[i].BeautyServiceName" type="hidden" />
                                    <label asp-for="Services[i].Selected" class="form-check-label fw-semibold">
                                        @Model.Services[i].BeautyServiceName
                                    </label>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left"></i> Назад
                        </a>
                        <button type="submit" class="btn btn-salon px-4">
                            <i class="bi bi-check-lg"></i> Запази
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
