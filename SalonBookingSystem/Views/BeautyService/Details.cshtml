@model SalonBookingSystem.Models.BeautyService

@{
    ViewData["Title"] = "Детайли";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-6">

        <div class="card">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="form-icon mb-3"><i class="bi bi-stars"></i></div>
                    <h2 class="fw-bold mb-1">@Model.Name</h2>
                    <p class="text-muted mb-0">Информация за услугата</p>
                </div>

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted"><i class="bi bi-hourglass-split me-1"></i> Продължителност</span>
                        <span class="fw-semibold">@Model.DurationMinutes минути</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-muted"><i class="bi bi-tag me-1"></i> Цена</span>
                        <span class="price fs-6">@Model.Price лв.</span>
                    </li>
                </ul>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left"></i> Назад
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-salon px-4">
                        <i class="bi bi-pencil"></i> Редакция
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>
