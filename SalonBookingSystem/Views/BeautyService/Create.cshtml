@model SalonBookingSystem.Models.BeautyService

@{
    ViewData["Title"] = "Добавяне на услуга";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-6">

        <div class="card">
            <div class="card-body p-4 p-md-5">

                <div class="text-center mb-4">
                    <div class="form-icon mb-3"><i class="bi bi-plus-lg"></i></div>
                    <h2 class="fw-bold mb-1">Добавяне на услуга</h2>
                    <p class="text-muted mb-0">Създайте нова услуга в салона.</p>
                </div>

                <form asp-action="Create">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="напр. Маникюр" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="DurationMinutes" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="DurationMinutes" class="form-control" />
                                <span class="input-group-text">мин.</span>
                            </div>
                            <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="Price" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <input asp-for="Price" class="form-control" />
                                <span class="input-group-text">лв.</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left"></i> Назад
                        </a>
                        <button type="submit" class="btn btn-salon px-4">
                            <i class="bi bi-check-lg"></i> Запази
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
