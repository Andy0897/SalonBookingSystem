@model SalonBookingSystem.Models.BeautyService

@{
    ViewData["Title"] = "Изтриване";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-5 col-md-7">

        <div class="card">
            <div class="card-body p-4 p-md-5 text-center">

                <div class="form-icon mb-3 bg-danger-subtle text-danger">
                    <i class="bi bi-trash"></i>
                </div>

                <h2 class="fw-bold mb-2">Потвърждение</h2>
                <p class="text-muted">Сигурни ли сте, че искате да изтриете тази услуга?</p>

                <div class="bg-light rounded-3 p-3 mb-4">
                    <h5 class="fw-bold mb-1">@Model.Name</h5>
                    <span class="text-muted small">@Model.DurationMinutes мин. · @Model.Price лв.</span>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex justify-content-center gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Отказ</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash"></i> Изтрий
                        </button>
                    </div>
                </form>

            </div>
        </div>

    </div>
</div>
