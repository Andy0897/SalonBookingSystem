@model IEnumerable<SalonBookingSystem.Models.BeautyService>

@{
    ViewData["Title"] = "Услуги";
}

<div class="py-3">

    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h2 class="fw-bold mb-1">Услуги</h2>
            <p>Управление на предлаганите услуги в салона.</p>
        </div>
        <a asp-action="Create" class="btn btn-salon">
            <i class="bi bi-plus-lg"></i> Добави услуга
        </a>
    </div>

    <div class="card overflow-hidden">

        @if (!Model.Any())
        {
            <div class="p-5 text-center">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <h5 class="fw-bold mt-2">Няма добавени услуги</h5>
                <p class="text-muted">Все още няма създадени услуги в системата.</p>
                <a asp-action="Create" class="btn btn-salon">Добави първата услуга</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Име</th>
                            <th>Продължителност</th>
                            <th>Цена</th>
                            <th class="text-end pe-4">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@item.Name</td>
                                <td><i class="bi bi-clock text-muted me-1"></i> @item.DurationMinutes мин.</td>
                                <td class="fw-semibold">@item.Price лв.</td>
                                <td class="text-end pe-4 text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-outline-secondary btn-sm" title="Детайли">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-outline-salon btn-sm" title="Редакция">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm" title="Изтрий">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</div>
